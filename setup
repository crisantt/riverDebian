# wlroots build
bash ~/Git/riverDebian/scipts/wlroots

# River Dependencies
sudo apt install libevdev-dev libevdev-doc libevdev-tools libevdev2
sudo apt install libpkgconf-dev libpkgconf3 pkg-config pkgconf pkgconf-bin scdoc

# user/environment stuff packages
sudo apt install qt6-wayland 

# User Packages
sudo apt install foot wget curl
