#!/usr/bin/env bash

sudo apt update && sudo apt upgrade

# What I need
sudo apt install git vim
# wlroots dependencies
sudo apt install meson build-essential ninja-build make cmake

#EGL GLS2
sudo apt install libegl-dev libegl1 libgl-dev libgl1 libgles-dev libgles1 libgles2 libglvnd-core-dev libglvnd-dev libglvnd0 libglx-dev libglx0 libopengl-dev libopengl0

#vulkan
sudo apt install libvulkan-dev libvulkan1 libvulkan-memory-allocator-dev libvulkan-volk-dev mesa-vulkan-drivers  vulkan-tools

# glslang
sudo apt install glslang-dev glslang-tools

# libdrm
sudo apt install libdrm-amdgpu1 libdrm-common libdrm-dev libdrm-radeon1 libdrm-intel1 libdrm-tests libdrm2

# libunput
sudo apt install libinput-bin libinput-dev libinput-tools libinput10

#xkbcommon
sudo apt install libxkbcommon-dev libxkbcommon-doc libxkbcommon-tools libxkbcommon-x11-0 libxkbcommon-x11-dev libxkbcommon0 libxkbregistry-dev libxkbregistry0

